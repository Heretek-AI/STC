# STC environment. Copy to .env (gitignored) via the first-run wizard.
# .env is NEVER committed; only this example ships.

# Lane runtime: rootless (default, only supported mode for untrusted work)
# or privileged-dev (socket-mounted manager; root-equivalent on this host).
STUDIO_LANE_RUNTIME=rootless

# Invoking user, so lane-created files match host ownership.
HOST_UID=1000
HOST_GID=1000

# Repo checkout to bind into lanes (host-identical path required).
STUDIO_REPO=.

# Harness versions pinned by the manager (dir, not image, absorbs CLI cadence).
STUDIO_OPENCODE_VERSION=latest
STUDIO_PI_VERSION=latest

OPENCODE_API_KEY=oc_sk_test
